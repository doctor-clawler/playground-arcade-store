{
  "name": "playground-arcade-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/publish.mjs",
    "sync": "node scripts/sync-games.mjs",
    "validate": "node scripts/validate.mjs",
    "add-game": "node scripts/add-game.mjs",
    "test": "node --test tests/*.test.mjs",
    "import-game": "node scripts/import-game.mjs",
    "build:web": "bash scripts/build_web.sh",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:saves": "node scripts/verify-saves.mjs && node scripts/verify-save-scenes.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  }
}
